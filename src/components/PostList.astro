---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/paths';
interface Props { posts: CollectionEntry<'blog'>[] }
const { posts } = Astro.props;
---
<div class="post-list">{posts.map(post => <a class="post-row" href={url(`blog/${post.id}/`)}><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' })}</time><div><h3>{post.data.title}</h3><p>{post.data.description}</p><div class="tags">{post.data.tags.map(tag => <span>{tag}</span>)}</div></div><span class="arrow" aria-hidden="true">↗</span></a>)}</div>
